<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/glow_bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glow_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_glowtts" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/glow_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEngineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Motor TTS ativo • Estilo Neon"
                    android:textColor="@color/glow_cyan"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glow_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teste rápido de voz"
                android:textColor="@color/glow_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSampleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/glow_surface_elevated"
                android:gravity="top|start"
                android:hint="Digite uma frase para testar o áudio..."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="14dp"
                android:text="Olá! O GlowTTS está a funcionar com som e visual novos."
                android:textColor="@color/glow_text_primary"
                android:textColorHint="@color/glow_text_secondary"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSpeakSample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_glow_button"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="52dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:text="Ouvir amostra"
                android:textColor="@color/glow_text_on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVoiceSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/glow_surface_elevated"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="Configurações de voz"
                android:textColor="@color/glow_text_primary"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenReader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/glow_surface_elevated"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="Leitor (TXT e Links)"
                android:textColor="@color/glow_cyan"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glow_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema Android"
                android:textColor="@color/glow_pink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Abra as definições de saída de texto para voz do Android para selecionar o GlowTTS como motor padrão."
                android:textColor="@color/glow_text_secondary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenTtsSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/glow_surface_elevated"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="Abrir definições de TTS do Android"
                android:textColor="@color/glow_cyan"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
